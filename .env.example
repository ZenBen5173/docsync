# LLM is optional: without a key the pipeline runs on deterministic parsers only.
LLM_PROVIDER=anthropic          # anthropic | openai
LLM_MODEL=claude-sonnet-5
LLM_API_KEY=
# Data + scoring
DOCCHECK_SOURCE=data/bundle     # bundle folder or http://localhost:8080
DOCCHECK_SCORING_URL=http://localhost:8080
PRODUCT_NAME=DocCheck
PIPELINE_CONCURRENCY=8
